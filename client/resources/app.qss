QMainWindow {
  background: #edf1f6;
}

QFrame#HeaderBar,
QFrame#FooterBar,
QFrame#Panel,
QFrame#DarkPanel,
QFrame#MetricCard,
QFrame#OperationNode,
QFrame#SelectorFilterPanel,
QFrame#StatusChip {
  border: 1px solid #d6dde7;
  border-radius: 8px;
  background: #ffffff;
}

QFrame#HeaderBar {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f5f7fa, stop:1 #e6ebf2);
}

QFrame#FooterBar {
  background: #f8fafc;
}

QLabel#AppTitle {
  color: #213245;
  font-size: 24px;
  font-weight: 700;
}

QLabel#AppSubtitle {
  color: #5a6878;
  font-size: 14px;
}

QLabel#SectionTitle {
  color: #223244;
  font-size: 18px;
  font-weight: 700;
}

QLabel#MutedLabel {
  color: #607086;
  font-size: 13px;
}

QListWidget {
  background: transparent;
  border: none;
  outline: none;
}

QScrollArea#SelectionScroll {
  background: transparent;
  border: none;
}

QScrollArea#OperationChainScroll {
  background: transparent;
  border: none;
}

QFrame#SelectorFilterPanel {
  background: #f8fafc;
  border-color: #d9e2ee;
}

QComboBox,
QLineEdit,
QDoubleSpinBox,
QSpinBox {
  min-height: 32px;
  border: 1px solid #cfd8e6;
  border-radius: 7px;
  background: #ffffff;
  color: #26384c;
  padding: 4px 10px;
  font-size: 13px;
}

QComboBox:hover,
QLineEdit:hover,
QDoubleSpinBox:hover,
QSpinBox:hover {
  border-color: #9fb1ca;
}

QComboBox:focus,
QLineEdit:focus,
QDoubleSpinBox:focus,
QSpinBox:focus {
  border-color: #214f8f;
}

QListWidget::item {
  margin: 0 0 8px 0;
  padding: 12px 14px;
  border: 1px solid #cfd8e6;
  border-radius: 8px;
  background: #f2f5f9;
  color: #344457;
  font-size: 13px;
}

QListWidget#PrimarySceneList::item {
  padding: 12px 14px;
  background: #f7f4ed;
  border-color: #ded4bf;
  color: #27384a;
  font-size: 14px;
}

QListWidget#TargetList::item {
  padding: 10px 14px;
  background: #eef7f3;
  border-color: #c9ded5;
  color: #27384a;
}

QListWidget#TemplateList::item {
  padding: 9px 12px;
  background: #f3f6fb;
  border-color: #ccd8ea;
  color: #27384a;
}

QListWidget::item:selected {
  background: #214f8f;
  color: #ffffff;
  border-color: #214f8f;
}

QPushButton {
  border: 1px solid #cfd7e3;
  border-radius: 8px;
  padding: 8px 14px;
  background: #eef2f7;
  color: #223244;
  font-size: 13px;
}

QPushButton:hover {
  background: #e3eaf4;
}

QPushButton[class="primary"] {
  background: #2d6cf6;
  border-color: #2d6cf6;
  color: #ffffff;
}

QPushButton[class="success"] {
  background: #1f9d68;
  border-color: #1f9d68;
  color: #ffffff;
}

QPushButton[class="warning"] {
  background: #e38b17;
  border-color: #e38b17;
  color: #ffffff;
}

QPushButton[class="danger"] {
  background: #cb3d3d;
  border-color: #cb3d3d;
  color: #ffffff;
}

QFrame#OperationNode {
  background: #f8fafc;
  border-color: #cfd8e6;
}

QLabel[class="operationStep"] {
  border: 1px solid #214f8f;
  border-radius: 12px;
  background: #214f8f;
  color: #ffffff;
  font-size: 12px;
  font-weight: 700;
}

QLabel[class="operationTitle"] {
  color: #223244;
  font-size: 13px;
  font-weight: 700;
}

QLabel[class="operationDetail"] {
  color: #607086;
  font-size: 12px;
}

QLabel[class="operationArrow"] {
  color: #8392a6;
  font-size: 18px;
  font-weight: 700;
}

QFrame#DarkPanel {
  background: #111317;
  border: 1px solid #cfd7e3;
}

QLabel[class="overlayTag"] {
  border: 1px solid #505a68;
  border-radius: 12px;
  background: #353c47;
  color: #eef3f8;
  padding: 4px 12px;
  font-size: 12px;
}

QFrame#MetricCard {
  background: #f8fafc;
}

QLabel[class="metricName"] {
  color: #6b7787;
  font-size: 12px;
}

QLabel[class="metricValue"] {
  color: #1f2d3d;
  font-size: 20px;
  font-weight: 700;
}

QPlainTextEdit {
  border: 1px solid #dde4ed;
  border-radius: 8px;
  background: #fbfcfe;
  color: #415165;
  font-size: 12px;
}

QTabWidget#RightPaneTabs::pane {
  border: 1px solid #d9e2ee;
  border-radius: 8px;
  background: #ffffff;
  top: -1px;
}

QTabBar::tab {
  min-height: 28px;
  padding: 6px 12px;
  border: 1px solid #d9e2ee;
  border-bottom: none;
  border-top-left-radius: 7px;
  border-top-right-radius: 7px;
  background: #eef3f8;
  color: #5b6b80;
  font-size: 13px;
}

QTabBar::tab:selected {
  background: #ffffff;
  color: #223244;
  font-weight: 700;
}

QTabBar::tab:hover {
  background: #f8fafc;
}

QWidget {
  font-family: "Microsoft YaHei UI", "Segoe UI";
}

QMainWindow {
  background: #f7f9fd;
}

QFrame#Panel {
  border: 1px solid #dce5f1;
  border-radius: 6px;
  background: #ffffff;
}

QWidget#CenterColumn {
  background: transparent;
}

QLabel[class="workflowStatus"] {
  border: 1px solid #dbe5f3;
  border-radius: 6px;
  background: #ffffff;
  color: #0d55d8;
  font-size: 13px;
  font-weight: 600;
  padding: 8px 18px;
}

QStackedWidget#WorkflowPageStack {
  border: 1px solid #dce5f1;
  border-radius: 6px;
  background: #ffffff;
}

QLabel[class="workflowHero"] {
  color: #18345b;
  font-size: 26px;
  font-weight: 700;
}

QLabel[class="workflowLead"] {
  color: #657b98;
  font-size: 14px;
  padding: 6px 20px;
}

QLabel[class="workflowSectionTitle"] {
  color: #0c3f91;
  font-size: 18px;
  font-weight: 700;
}

QFrame#WorkflowCard {
  border: 1px solid #dce5f1;
  border-radius: 5px;
  background: #ffffff;
}

QFrame#WorkflowCard[class="selectedTemplate"] {
  border: 2px solid #2c6df6;
  background: #fbfdff;
}

QFrame#WorkflowCard[state="warning"] {
  border-color: #f3aa4e;
  background: #fff8ec;
}

QFrame#WorkflowCard[state="success"] {
  border-color: #cfe8dc;
  background: #fbfffd;
}

QFrame#WorkflowCard[rightStatus="true"] {
  border: none;
  border-bottom: 1px solid #dce5f1;
  border-radius: 0;
  background: transparent;
}

QLabel[class="workflowCardTitle"] {
  color: #0b4099;
  font-size: 14px;
  font-weight: 700;
}

QLabel[class="workflowCardDetail"] {
  color: #36567f;
  font-size: 13px;
  line-height: 1.35;
}

QLabel[class="templateChoiceTitle"] {
  color: #0b4099;
  font-size: 18px;
  font-weight: 700;
}

QLabel[class="templateChoiceDetail"] {
  color: #36567f;
  font-size: 14px;
}

QLabel[class="templateChoiceFlow"] {
  color: #174b9b;
  font-size: 13px;
  font-weight: 600;
}

QLabel[class="templateMetadata"] {
  color: #536d91;
  font-size: 13px;
}

QLabel[class="capabilityName"],
QLabel[class="precheckRowName"] {
  color: #244b82;
  font-size: 13px;
  font-weight: 700;
}

QLabel[class="capabilityValue"],
QLabel[class="precheckRowValue"] {
  color: #36567f;
  font-size: 13px;
}

QLabel[class="precheckPassName"],
QLabel[class="precheckPassState"] {
  color: #1b9b55;
  font-size: 13px;
  font-weight: 600;
}

QLabel[class="precheckWarningName"],
QLabel[class="precheckWarningState"] {
  color: #d97706;
  font-size: 13px;
  font-weight: 600;
}

QLabel[class="galleryBadgeSuccess"] {
  border: 2px solid #ffffff;
  border-radius: 15px;
  background: #19a862;
  color: #ffffff;
  font-size: 16px;
  font-weight: 700;
}

QLabel[class="galleryBadgeProgress"] {
  border: 2px solid #2f73ff;
  border-radius: 20px;
  background: #123b86;
  color: #ffffff;
  font-size: 12px;
  font-weight: 700;
}

QLabel[class="galleryBadgeWaiting"] {
  border: 2px solid #ffffff;
  border-radius: 15px;
  background: #596371;
  color: #ffffff;
  font-size: 12px;
  font-weight: 700;
}

QLabel[class="workflowProtocol"] {
  border: 1px solid #b7cffc;
  border-radius: 5px;
  background: #f5f9ff;
  color: #0a54d5;
  font-size: 14px;
  font-weight: 700;
  padding: 12px;
}

QLabel[class="evidenceLabel"] {
  border: 1px solid #cde1ff;
  border-radius: 4px;
  background: #f6faff;
  color: #315f9c;
  font-size: 12px;
  padding: 8px 10px;
}

QLabel[class="warningNote"] {
  border: 1px solid #f4a443;
  border-radius: 5px;
  background: #fff8ed;
  color: #d96b00;
  font-size: 12px;
  padding: 10px;
}

QLabel[class="warningText"] {
  color: #d96b00;
  font-weight: 600;
}

QFrame[selected="true"] {
  border: 2px solid #2f73ff;
  background: #f7faff;
}

QPushButton[role="orientationThumbnail"] {
  border: 1px solid #dce5f1;
  border-radius: 5px;
  background: #ffffff;
  padding: 4px;
}

QPushButton[role="orientationThumbnail"]:hover,
QPushButton[role="orientationThumbnail"]:focus {
  border-color: #7aa5f8;
  background: #f7faff;
}

QPushButton[role="orientationThumbnail"][selected="true"] {
  border: 2px solid #2f73ff;
  background: #f7faff;
}

QLabel[class="orientationThumbnailLabel"] {
  border: 0;
  background: transparent;
  color: #315f9c;
  font-size: 11px;
  padding: 1px 2px;
}

QSlider::groove:horizontal {
  height: 6px;
  border-radius: 3px;
  background: #dce7f5;
}

QSlider::sub-page:horizontal {
  border-radius: 3px;
  background: #2d6cf6;
}

QSlider::handle:horizontal {
  width: 16px;
  margin: -5px 0;
  border: 2px solid #ffffff;
  border-radius: 8px;
  background: #2d6cf6;
}

QLabel[class="runHold"] {
  color: #164ca3;
  font-size: 14px;
  font-weight: 600;
  padding-right: 6px;
}

QPushButton {
  min-height: 24px;
  border-radius: 5px;
  padding: 7px 14px;
}

QPushButton:disabled {
  background: #edf0f4;
  border-color: #e2e6ec;
  color: #a8b1bd;
}

QPushButton[class="running"]:disabled {
  background: #1677ff;
  border-color: #1677ff;
  color: #ffffff;
}

QProgressBar {
  min-height: 18px;
  border: 1px solid #d4dfed;
  border-radius: 5px;
  background: #e9eef6;
  color: #173c70;
  text-align: center;
}

QProgressBar::chunk {
  border-radius: 4px;
  background: #2995ff;
}

QTableWidget {
  border: 1px solid #dce5f1;
  border-radius: 5px;
  background: #ffffff;
  alternate-background-color: #f7faff;
  color: #284d7c;
  gridline-color: #e4ebf4;
  selection-background-color: #e7f0ff;
  selection-color: #123f86;
  font-size: 13px;
}

QHeaderView::section {
  border: none;
  border-bottom: 1px solid #dce5f1;
  background: #f5f8fc;
  color: #31557f;
  font-weight: 600;
  font-size: 13px;
  padding: 7px;
}

QLineEdit[class="tableEditor"] {
  min-height: 24px;
  border: 1px solid #8fb5ff;
  border-radius: 4px;
  background: #fbfdff;
  color: #184b95;
  padding: 3px 7px;
  font-size: 13px;
}

QCheckBox {
  color: #234c84;
  font-size: 13px;
  spacing: 8px;
}

QStackedWidget#WorkflowPageStack QPushButton {
  min-height: 28px;
  font-size: 13px;
}
